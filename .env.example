# Packaged apps store the key in the OS credential store. This file is only for local test helpers.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Public Relay values only. Service-role and Devin credentials belong only in
# Supabase Edge Function secrets and must never appear in a Vite env file.
#
# For the macOS/Tauri publisher, copy these to an ignored root .env or
# .env.production file (or export them in the build shell).
# For a local Relay Web production build, put only the first two values in the
# ignored apps/relay-web/.env.production.local file. In Vercel, configure those
# same two values in Project Environment. VITE_RELAY_WEB_URL is desktop-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_RELAY_WEB_URL=

# Local integration only. This opt-in permits exact localhost/127.0.0.1/::1
# HTTP and WS endpoints in development; remote plaintext origins remain blocked.
# Never set this value in Vercel or a distributable build.
VITE_RELAY_LOCAL_INTEGRATION=0
