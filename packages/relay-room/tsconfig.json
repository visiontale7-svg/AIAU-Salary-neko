{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@dialogue-atlas/atlas-graph": ["../atlas-graph/src/index.ts"],
      "@dialogue-atlas/relay-contract": ["../relay-contract/src/index.ts"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
